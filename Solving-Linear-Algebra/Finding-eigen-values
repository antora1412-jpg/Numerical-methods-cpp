#include<iostream>
#include<iomanip>
#include<cmath>
using namespace std;
int main()
{
	cout.precision(5);
	cout.setf(ios::fixed);
	int i,j,n;
	cout<<"enter the order of the matrix"<<endl;
	cin>>n;
	double a[n][n],b[n],c[n],k,ep,y;
	cout<<"enter the elements of the matrix"<<endl;
	cout<<"please avoid the diagonal matrix"<<endl;
	for(i=0;i<n;i++)
	for(j=0;j<n;j++)
	cin>>a[i][j];
	cout<<"enter the desired accuracy"<<endl;
	cin>>ep;
	cout<<"enter the initial guess for the eigen matrix"<<endl;
	for(j=0;j<n;j++)
	cin>>b[j];
	k=b[0];
	do
	{
	y=k;
	for(i=0;i<n;i++)
	{
	c[i]=0;
	for(j=0;j<n;j++)
	c[i]=c[i]+a[i][j]*b[j];	
	}
	k=abs(c[0]);
	for(i=1;i<n;i++)
	if(k<abs(c[i]))
	k=abs(c[i]);
	for(i=0;i<n;i++)
	b[i]=c[i]/k;
    }while(abs(y-k)>=ep);
    cout<<"the largest eigen value is"<<k<<endl;
    cout<<"the required eigen vector is"<<endl;
    for(i=0;i<n;i++)
    cout<<b[i]<<endl;
    return 0;
}
